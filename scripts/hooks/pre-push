#!/usr/bin/env bash
# Runs the live behave suites before a push, so live verification gates the push
# WITHOUT CI ever holding a credential (CI runs only the offline mock suites). Skip a
# work-in-progress push with `git push --no-verify`.
#
# One-time install (per clone):  git config core.hooksPath scripts/hooks
#
# The live Google Workspace test (`uv run pytest -m credentials`) is deliberately not
# run here. It needs the domain-wide delegation key, which should not sit on a
# developer's disk just so every push can use it. It is a by-hand check that a
# tenant's key and delegation are set up correctly.
#
# The Solidarity Tech token is read from the environment, or from a local .env if
# present (set -a exports each assignment). Without it the hook is a no-op, so it
# never blocks a push it cannot meaningfully gate (a fresh clone, or CI).
set -euo pipefail

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

if [ -z "${SOLIDARITY_TECH_TOKEN:-}" ]; then
  echo "pre-push: no Solidarity Tech token present; skipping live suites" >&2
  exit 0
fi

echo "pre-push: running live suites (use 'git push --no-verify' to skip)..."

# Live behave suites are gated by the @live tag and the environment.py credential
# check. With no @live scenarios yet this is a no-op pass; it activates as they land.
uv run behave --tags=@live

echo "pre-push: live suites passed"
